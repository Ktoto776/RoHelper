Заметки реализованных разрешений:
    os.time  -- Даёт доступ функциям времени в os (если нету os = nil),
    create.window  -- Даёт доступ к созданию окна через script:createWindow
    create.tray_button  -- Даёт доступ к кнопке в меню трея через script:getTrayMenuButton
    read_logs.all  -- На чтение всех логов, автоматически даёт "roblox.joined_server" и 
                                "read_logs.join_event" и "read_logs.left_event"
    read_logs.join_event  -- Эвент, запускаемый когда игрок заходит в игру
    roblox.joined_server  -- Данные о сервере на котором игрок, 
                автоматически даёт "read_logs.join_event"  и "read_logs.left_event"
    read_logs.left_event  -- Эвент, запускаемый когда игрок выходит из игры